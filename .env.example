APP_NAME="Pharma Strategies"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pharma_strategies
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
# Keep chat attachments private. For Render with a persistent disk, set CHAT_ATTACHMENT_DISK=chat_attachments and point the root at the mounted disk.
CHAT_ATTACHMENT_DISK=local
CHAT_ATTACHMENT_LOCAL_ROOT=storage/app/private

REVERB_SERVER=reverb
REVERB_APP_ID=pharma-strategies-local
REVERB_APP_KEY=pharma-strategies-local-key
REVERB_APP_SECRET=pharma-strategies-local-secret
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SCALING_ENABLED=false
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_APP_MAX_MESSAGE_SIZE=10000

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

WEB_PUSH_ENABLED=false
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@pharmastrategies.ca"
MAIL_FROM_NAME="${APP_NAME}"

MESSAGE_EDIT_WINDOW_MINUTES=10
MESSAGE_DELETE_WINDOW_MINUTES=5
CHAT_MAX_ATTACHMENTS=5
CHAT_MAX_TOTAL_UPLOAD_MB=120
CHAT_MAX_IMAGE_MB=10
CHAT_MAX_VIDEO_MB=100
CHAT_MAX_DOCUMENT_MB=25

# Render / production notes
# APP_URL=https://your-service.onrender.com
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true
# REVERB_SERVER_HOST=127.0.0.1
# REVERB_SERVER_PORT=8081
# REVERB_HOST=127.0.0.1
# REVERB_PORT=8081
# REVERB_SCHEME=http
# REVERB_ALLOWED_ORIGINS=your-service.onrender.com
# VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
# VITE_REVERB_HOST=
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https
# RUN_MIGRATIONS=true
