# Install as /etc/pharma/backup.env, root:root 0600. Never commit real credentials.
# Use a separate off-server repository in the approved Canadian location.
RESTIC_REPOSITORY=s3:https://YOUR-CANADIAN-ENDPOINT/YOUR-BUCKET/pharma
RESTIC_PASSWORD_FILE=/etc/pharma/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MYSQL_CNF=/etc/pharma/mysql-backup.cnf
BACKUP_DATABASE=pharma
# Optional, explicitly approved expiry: 7 daily, 4 weekly, 12 monthly snapshots.
BACKUP_PRUNE=false
