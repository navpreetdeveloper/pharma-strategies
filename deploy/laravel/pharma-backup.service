[Unit]
Description=Pharma Strategies coordinated encrypted off-server backup
After=network-online.target
Wants=network-online.target
OnFailure=pharma-backup-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/pharma/backup.env
ExecStart=/usr/local/sbin/pharma-backup
UMask=0077
TimeoutStartSec=30min
TimeoutStopSec=120
PrivateTmp=true
NoNewPrivileges=true
