{
  "name": "pharma/strategies",
  "type": "project",
  "require": {
    "php": "^8.4.1",
    "laravel/framework": "^12.0",
    "laravel/reverb": "^1.12",
    "minishlink/web-push": "^11.0",
    "guzzlehttp/guzzle": "^7.9",
    "laravel/fortify": "^1.41",
    "php-http/guzzle7-adapter": "~1.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "laravel/pint": "^1.0",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ],
    "test": "@php vendor/phpunit/phpunit/phpunit",
    "format:check": "@php vendor/bin/pint --test app routes config database tests bootstrap/app.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
